#!/usr/bin/env bash
# qa-transcribe <audio|video file> [de|en|ru|auto] [out-dir]
# Local transcription with whisper.cpp — nothing leaves this machine.
# Writes <name>.txt (plain) and <name>.srt (with timestamps) into out-dir (default: next to the file).
set -euo pipefail

in="${1:?usage: qa-transcribe <file> [de|en|ru|auto] [out-dir]}"
lang="${2:-auto}"
out="${3:-$(dirname "$in")}"
model="${WHISPER_MODEL:-$HOME/.local/share/whisper/ggml-large-v3-turbo.bin}"

command -v whisper-cli >/dev/null || { echo "whisper-cli not installed (brew install whisper-cpp)"; exit 1; }
command -v ffmpeg >/dev/null || { echo "ffmpeg not installed (brew install ffmpeg)"; exit 1; }
[[ -f "$model" ]] || { echo "Whisper model not found: $model"; exit 1; }

mkdir -p "$out"
base="$out/$(basename "${in%.*}")"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

ffmpeg -loglevel error -y -i "$in" -ar 16000 -ac 1 -c:a pcm_s16le "$tmp/audio.wav"
whisper-cli -m "$model" -l "$lang" -f "$tmp/audio.wav" -otxt -osrt -of "$base" >/dev/null 2>&1

echo "Transcript: $base.txt"
echo "Timestamps: $base.srt"
